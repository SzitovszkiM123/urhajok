<Window x:Class="urhajok.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:urhajok"
        mc:Ignorable="d"
        Title="Űrhajók" Height="555" Width="1030">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*"/>
            <ColumnDefinition Width="2.2*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Orientation="Vertical" Grid.Column="0" Background="#FF14293A">
        <TextBlock Text="Űrhajó műveletek" Foreground="White" FontSize="24" FontWeight="Bold" Margin="5,5,5,15"/>
        <Button Content="Adatok betöltése" Margin="10,10,10,5" Padding="5" Click="betolt"/>
        </StackPanel>
        <DataGrid x:Name="dgrid" Grid.Column="1" SelectionChanged="dgrid_SelectionChanged"/>
    </Grid>
</Window>